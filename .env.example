GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
USER_ID_PEPPER=

# Public origin used to build emailed links. Required in production.
APP_URL=http://localhost:3001
# Leave empty in development: reset and verification links are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=
# Optional PBKDF2 override, clamped to 100000-1000000.
PASSWORD_HASH_ITERATIONS=
