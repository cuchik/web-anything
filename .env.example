GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
USER_ID_PEPPER=

# Public origin used to build emailed links. Required in production.
APP_URL=http://localhost:3001
# Required for email delivery in every environment. Auth links are never logged.
RESEND_API_KEY=
EMAIL_FROM=
# Optional PBKDF2 override, validated as an integer from 100000 to 1000000.
PASSWORD_HASH_ITERATIONS=
